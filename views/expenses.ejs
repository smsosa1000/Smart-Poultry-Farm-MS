<%- include('partials/header') %>
<div class="page-title"><h1><i class="fa-solid fa-money-bill-transfer"></i> Expenses</h1></div>
<div class="split-layout">
    <% if (user.user_role === 'Manager' || user.is_admin) { %>
    <div class="card flex-1">
        <div class="card-header"><h2><i class="fa-solid fa-plus"></i> Record Expense</h2></div>
        <div class="card-body">
            <form action="/expenses" method="POST">
                <div class="form-group">
                    <label for="cycle_id">Cycle</label>
                    <select id="cycle_id" name="cycle_id" required>
                        <% cycles.forEach(c => { %><option value="<%= c.cycle_id %>">#<%= c.cycle_id %></option><% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="category">Category</label>
                    <select id="category" name="category" required>
                        <% (typeof categories !== 'undefined' ? categories : []).forEach(cat => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group"><label for="notes">Notes (Details)</label><input type="text" id="notes" name="notes" placeholder="Optional details..."></div>
                <div class="form-row">
                    <div class="form-group"><label for="amount">Amount (EGP)</label><input type="number" step="0.01" id="amount" name="amount" required></div>
                    <div class="form-group"><label for="expense_date">Date</label><input type="date" id="expense_date" name="expense_date" value="<%= new Date().toISOString().split('T')[0] %>" required></div>
                </div>
                <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-save"></i> Save</button>
            </form>
        </div>
    </div>
    <% } %>
    <div class="card flex-2">
        <div class="card-header"><h2><i class="fa-solid fa-list"></i> Expense History</h2></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="data-table">
                    <thead><tr><th>Date</th><th>Cycle</th><th>Category</th><th>Notes</th><th>Amount</th></tr></thead>
                    <tbody>
                        <% expenses.forEach(e => { %>
                        <tr>
                            <td><%= new Date(e.expense_date).toLocaleDateString() %></td>
                            <td>#<%= e.cycle_id %></td>
                            <td><span class="badge badge-secondary"><%= e.category %></span></td>
                            <td><%= e.notes || '—' %></td>
                            <td class="text-danger"><%= parseFloat(e.amount).toLocaleString() %> EGP</td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
