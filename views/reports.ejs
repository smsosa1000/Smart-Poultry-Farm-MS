<%- include('partials/header') %>
<div class="page-title">
    <h1><i class="fa-solid fa-chart-line"></i> Automated Reports</h1>
    <% if (reportData) { %>
    <button onclick="window.print()" class="btn btn-secondary no-print">
        <i class="fa-solid fa-print"></i> Print Report
    </button>
    <% } %>
</div>

<style>
    @media print {
        .no-print, .sidebar, .header-actions, .nav-menu { display: none !important; }
        .main-content { margin-left: 0 !important; width: 100% !important; padding: 0 !important; }
        .card { border: 1px solid #ddd !important; box-shadow: none !important; }
        .page-title h1 { font-size: 24px; color: #333; }
    }
</style>

<div class="card mb-4 no-print">
    <div class="card-body">
        <form method="GET" action="/reports" class="form-inline-grid">
            <select name="cycle_id" onchange="this.form.submit()">
                <% cycles.forEach(c => { %>
                    <option value="<%= c.cycle_id %>" <%= reportData && reportData.cycle_id === c.cycle_id ? 'selected' : '' %>>
                        Cycle #<%= c.cycle_id %> - <%= c.breed_name %> (<%= c.cycle_status %>)
                    </option>
                <% }) %>
            </select>
        </form>
    </div>
</div>

<% if (reportData) { %>
<div class="stats-grid">
    <div class="stat-card stat-primary">
        <div class="stat-icon"><i class="fa-solid fa-scale-balanced"></i></div>
        <div class="stat-info"><h3>FCR</h3><div class="value"><%= reportData.fcr %></div><small><%= reportData.fcrType %></small></div>
    </div>
    <div class="stat-card stat-danger">
        <div class="stat-icon"><i class="fa-solid fa-skull"></i></div>
        <div class="stat-info"><h3>Mortality Rate</h3><div class="value"><%= reportData.mortalityRate %>%</div><small><%= reportData.total_dead %> of <%= reportData.initial_chicks %></small></div>
    </div>
    <div class="stat-card stat-success">
        <div class="stat-icon"><i class="fa-solid fa-money-bill-trend-up"></i></div>
        <div class="stat-info"><h3>Net Profit</h3><div class="value <%= reportData.netProfit >= 0 ? 'text-success' : 'text-danger' %>"><%= parseFloat(reportData.netProfit).toLocaleString() %> EGP</div></div>
    </div>
    <div class="stat-card stat-warning">
        <div class="stat-icon"><i class="fa-solid fa-wheat-awn"></i></div>
        <div class="stat-info"><h3>Total Feed</h3><div class="value"><%= parseFloat(reportData.total_feed).toLocaleString() %> kg</div></div>
    </div>
</div>

<div class="grid-2">
    <div class="card">
        <div class="card-header"><h2><i class="fa-solid fa-arrow-trend-up"></i> Revenue</h2></div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item"><span class="info-label">Total Revenue</span><span class="info-value text-success"><%= parseFloat(reportData.total_revenue).toLocaleString() %> EGP</span></div>
                <div class="info-item"><span class="info-label">Total Weight Sold</span><span class="info-value"><%= parseFloat(reportData.total_weight).toLocaleString() %> kg</span></div>
                <div class="info-item"><span class="info-label">Avg Price/kg</span><span class="info-value"><%= reportData.avg_price %> EGP</span></div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h2><i class="fa-solid fa-arrow-trend-down"></i> Cost Breakdown</h2></div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item"><span class="info-label">Chick Purchase</span><span class="info-value text-danger"><%= parseFloat(reportData.chick_cost).toLocaleString() %> EGP</span></div>
                <div class="info-item"><span class="info-label">Feed Cost</span><span class="info-value text-danger"><%= parseFloat(reportData.feed_cost).toLocaleString() %> EGP</span></div>
                <div class="info-item"><span class="info-label">Treatment Cost</span><span class="info-value text-danger"><%= parseFloat(reportData.treatment_cost).toLocaleString() %> EGP</span></div>
                <div class="info-item"><span class="info-label">Other Expenses</span><span class="info-value text-danger"><%= parseFloat(reportData.total_expenses).toLocaleString() %> EGP</span></div>
                <div class="info-item info-total"><span class="info-label">TOTAL COST</span><span class="info-value text-danger"><%= parseFloat(reportData.total_cost).toLocaleString() %> EGP</span></div>
            </div>
        </div>
    </div>
</div>
<% } else { %>
    <div class="empty-state"><i class="fa-solid fa-chart-line fa-3x"></i><h2>No Data</h2><p>No cycles available for reporting.</p></div>
<% } %>
<%- include('partials/footer') %>
